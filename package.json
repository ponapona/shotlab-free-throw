{
  "name": "shotlab-free-throw",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-local free throw pose analysis and reproducible feature export",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "scripts": {
    "config": "node scripts/generate-config.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "docs": "npm run config && node analysis/write_guides.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run docs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run config && node --test tests/*.test.mjs",
    "format": "prettier --write src components lib public/*.mjs analysis/*.mjs scripts tests config docs *.md *.json *.ts .github/workflows/*.yml"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "radix-ui": "1.6.7",
    "lucide-react": "1.31.0",
    "sonner": "2.0.8",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "prettier": "3.6.2"
  }
}
